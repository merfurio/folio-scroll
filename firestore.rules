rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O site lê o conteúdo sem login. Só o(s) email(s) da lista escrevem.
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email in ['TROCAR@EMAIL.COM'];
    }
  }
}
