rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Qualquer pessoa vê as imagens/vídeos do site; só admins enviam (até 200 MB, só imagem/vídeo).
    match /media/{file=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 200 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
